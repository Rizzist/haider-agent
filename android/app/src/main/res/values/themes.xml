<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework NoActionBar theme so the ComponentActivity hosts Compose with
         no app bar. The day variant paints the Session Deck light ground
         (#f5f5f7); values-night paints the dark ground (#07090d). Before 971
         this file hardcoded #07090d for both, so every light-theme cold start
         flashed black (UI-SPEC trap 6.6.8). -->
    <style name="Theme.Haider" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/forge_bg</item>
        <item name="android:statusBarColor">@color/forge_bg</item>
        <item name="android:navigationBarColor">@color/forge_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
