<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>haider</id>
    <version>__HAIDER_VERSION__</version>
    <title>Haider Agent CLI</title>
    <authors>Rizzist</authors>
    <owners>Rizzist</owners>
    <projectUrl>https://github.com/Rizzist/haider-agent</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/Rizzist/haider-agent@v__HAIDER_ICON_VERSION__/packaging/chocolatey/icon.png</iconUrl>
    <packageSourceUrl>https://github.com/Rizzist/haider-agent</packageSourceUrl>
    <licenseUrl>https://github.com/Rizzist/haider-agent/blob/main/LICENSE.md</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Provider-agnostic coding-agent TUI and runtime. Installs both haider and its required sibling daemon haiderd.</description>
    <summary>Haider coding-agent terminal interface.</summary>
    <tags>haider cli tui ai agent developer-tools</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
