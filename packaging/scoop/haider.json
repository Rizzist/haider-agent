{
  "version": "0.0.968",
  "description": "Provider-agnostic coding-agent TUI and runtime",
  "homepage": "https://github.com/Rizzist/haider-agent",
  "license": {
    "identifier": "LicenseRef-KOA-P-1.0",
    "url": "https://github.com/Rizzist/haider-agent/blob/main/LICENSE.md"
  },
  "architecture": {
    "64bit": {
      "url": "https://github.com/Rizzist/haider-agent/releases/download/v0.0.968/haider-v0.0.968-x86_64-pc-windows-msvc.zip",
      "hash": "e1018c8c5e00219b15abe7051bd244aaee5b42d117d6bf0c131c38ff5156b354",
      "extract_dir": "haider-v0.0.968-x86_64-pc-windows-msvc"
    }
  },
  "bin": [
    "haider.exe"
  ],
  "checkver": {
    "url": "https://api.github.com/repos/Rizzist/haider-agent/releases?per_page=20",
    "regex": "\"tag_name\"\\s*:\\s*\"v([0-9]+(?:\\.[0-9]+)*)\""
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/Rizzist/haider-agent/releases/download/v$version/haider-v$version-x86_64-pc-windows-msvc-split.zip",
        "extract_dir": "haider-v$version-x86_64-pc-windows-msvc-split"
      }
    },
    "hash": {
      "url": "$url.sha256",
      "regex": "([a-fA-F0-9]{64})"
    }
  },
  "pre_install": [
    "$binaries = @('haider.exe', 'haiderd.exe')",
    "if ($manifest.architecture.'64bit'.url -match '-split\\.zip$') { $binaries += 'haider-tui.exe' }",
    "foreach ($binary in $binaries) {",
    "    $path = Join-Path $dir $binary",
    "    if (!(Test-Path $path -PathType Leaf)) { throw \"Release archive did not contain $binary\" }",
    "    $actual = (& $path --version | Out-String).Trim()",
    "    $product = $binary -replace '\\.exe$', ''",
    "    if ($LASTEXITCODE -ne 0 -or $actual -cne \"$product $version\") { throw \"Release sibling version mismatch: $binary reported $actual\" }",
    "}"
  ]
}
