    {
      "name": "spawn_subagent",
      "description": "Delegate one bounded task to a depth-capped child under AgentSpawn policy; waits for child report. Inherits the current model/provider. Call list_tools(filter=\"spawn_subagent\") for optional model/provider, workflow, specialist, and request-budget controls.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "description": "Complete task prompt for the child",
            "maxLength": 32768,
            "minLength": 1,
            "type": "string"
          },
          "task": {
            "description": "Short display label for the child",
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "task",
          "prompt"
        ],
        "type": "object"
      }
