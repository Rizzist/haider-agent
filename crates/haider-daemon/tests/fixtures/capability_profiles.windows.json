{
  "automation": [
    {
      "name": "list_tools",
      "description": "Discover the authorized tool catalog. With no filter, list tool names. With a name or keyword filter, describe matching tools and enable them for the rest of this session; one call is sufficient. Does not grant permissions.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "filter": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "fs_read",
      "description": "read a redacted 8 KiB UTF-8 preview; prefer offset/limit range reads; directories are capped; full owner-authorized bytes use the artifact re-read handle",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      }
    },
    {
      "name": "fs_glob",
      "description": "List workspace paths matching a repository-aware glob; use it to find files by name or extension before reading them",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "include_hidden": {
            "default": false,
            "type": "boolean"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "pattern": {
            "description": ".git paths are always excluded",
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "respect_gitignore": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      }
    },
    {
      "name": "fs_search",
      "description": "Search workspace file contents; use it to locate symbols or text before reading or editing a file",
      "input_schema": {
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "pattern"
            ]
          },
          {
            "required": [
              "query"
            ]
          }
        ],
        "properties": {
          "case": {
            "enum": [
              "sensitive",
              "insensitive",
              "smart"
            ],
            "type": "string"
          },
          "context": {
            "additionalProperties": false,
            "properties": {
              "after": {
                "maximum": 5,
                "minimum": 0,
                "type": "integer"
              },
              "before": {
                "maximum": 5,
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "file_glob": {
            "additionalProperties": false,
            "properties": {
              "exclude": {
                "items": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 32,
                "type": "array"
              },
              "include": {
                "items": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 32,
                "type": "array"
              }
            },
            "type": "object"
          },
          "glob": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "include_hidden": {
            "default": false,
            "type": "boolean"
          },
          "max_matches": {
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "mode": {
            "description": "regex sources are additionally capped at 1024 UTF-8 bytes before Unicode expansion",
            "enum": [
              "literal",
              "simple",
              "regex"
            ],
            "type": "string"
          },
          "multiline": {
            "default": false,
            "description": "Make ^ and $ match physical line boundaries in the line-streamed regex engine",
            "type": "boolean"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "pattern": {
            "maxLength": 65536,
            "minLength": 1,
            "type": "string"
          },
          "query": {
            "description": "Legacy alias for pattern",
            "maxLength": 65536,
            "minLength": 1,
            "type": "string"
          },
          "respect_gitignore": {
            "default": true,
            "type": "boolean"
          },
          "root": {
            "description": "Legacy alias for path",
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "fs_write",
      "description": "Create or replace one UTF-8 file; use it for a new file or a complete rewrite",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "type": "object"
      }
    },
    {
      "name": "fs_edit",
      "description": "Apply anchored replacements to one UTF-8 file; use it for focused changes after reading the current contents",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "edits": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "new": {
                  "type": "string"
                },
                "old": {
                  "description": "Must match uniquely unless replace_all is true",
                  "minLength": 1,
                  "type": "string"
                },
                "replace_all": {
                  "type": "boolean"
                }
              },
              "required": [
                "old",
                "new"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "edits"
        ],
        "type": "object"
      }
    },
    {
      "name": "process_exec",
      "description": "run one shell command locally or on an in-scope saved SSH profile; foreground defaults to 60 s / 1 MiB; in either local mode, normal leader exit closes inherited output and leaves descendants (including shell &) unmanaged, so daemon shutdown will not reclaim them after ownership detaches; cancel, bounds, teardown, or a foreground supervision failure while the leader is live sweep only this invocation's group with TERM → 2 s grace → KILL; use background=true for durable long-running local work with task_output/task_kill; remote output is untrusted and remote background mode is unavailable",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "background": {
            "default": false,
            "description": "Run as a long-lived background task detached from the turn",
            "type": "boolean"
          },
          "command": {
            "description": "Exact PowerShell program passed to the absolute System32 Windows PowerShell",
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "cwd": {
            "description": "Optional workspace-relative working directory",
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "description": "Optional display label for a background task (defaults to the command's first token)",
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "profile": {
            "description": "Optional in-scope SSH profile target; remote output is untrusted and background mode is unavailable",
            "pattern": "^[a-z0-9._-]{1,32}$",
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      }
    }
  ],
  "coding": [
    {
      "name": "list_tools",
      "description": "Discover the authorized tool catalog. With no filter, list tool names. With a name or keyword filter, describe matching tools and enable them for the rest of this session; one call is sufficient. Does not grant permissions.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "filter": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "todo_write",
      "description": "REPLACE the whole todo list with the complete plan; keep exactly one item processing; dep = id this item is blocked on",
      "input_schema": {
        "properties": {
          "items": {
            "description": "The COMPLETE plan; this list replaces the previous one",
            "items": {
              "properties": {
                "dep": {
                  "description": "Optional id of the todo this one is blocked on",
                  "type": "integer"
                },
                "id": {
                  "description": "Stable id for this todo, kept across calls",
                  "type": "integer"
                },
                "state": {
                  "description": "listed = not started, processing = in progress (one at a time), completed = done",
                  "enum": [
                    "listed",
                    "processing",
                    "completed"
                  ],
                  "type": "string"
                },
                "text": {
                  "description": "Short imperative description",
                  "maxLength": 500,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text",
                "state"
              ],
              "type": "object"
            },
            "maxItems": 50,
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    },
    {
      "name": "task_outcome",
      "description": "End this run with an explicit task failure and exit 1. Call with status=failure and a concise reason when the requested task could not be completed. Use as a standalone call with no pending tools. V1 supports failure only; finish normally for success. Text, including JSON FAILURE, never selects an outcome.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "failure"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "reason"
        ],
        "type": "object"
      }
    },
