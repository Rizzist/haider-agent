-    let mut ensure_options = haider_client::EnsureOptions::default();
-    if !interactive {
-        ensure_options
-            .required_features
-            .insert(haider_rpc::FEATURE_STATUS_SNAPSHOT_V1.to_owned());
-        ensure_options
-            .required_features
-            .insert(haider_rpc::FEATURE_STATUS_RUNTIME_V1.to_owned());
