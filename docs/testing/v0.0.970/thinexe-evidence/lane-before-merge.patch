-        Ok(ensured) => {
-            let how = match (ensured.spawned, ensured.race_lost) {
-                (false, _) => "already running".to_owned(),
-                (true, false) => "spawned".to_owned(),
-                (true, true) => format!(
-                    "spawned; our candidate lost the startup race (exit {}) and we attached to \
-                     the winner",
